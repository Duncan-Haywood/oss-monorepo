# exiftool user-defined XMP namespace for igmp's machine fields.
# Used only when merging into an XMP sidecar another app also writes.
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        igmp => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::igmp' } },
    },
);
%Image::ExifTool::UserDefined::igmp = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-igmp', 2 => 'Image' },
    NAMESPACE => { 'igmp' => 'http://ns.igmp.dev/1.0/' },
    WRITABLE => 'string',
    Writer => { }, AssetId => { }, EventKey => { }, Kind => { }, Camera => { },
    GPSPrecision => { }, GPSErrorM => { Writable => 'real' }, Candidate => { Writable => 'boolean' }, BurstId => { },
    Sharpness => { Writable => 'real' }, Score => { Writable => 'real' }, Keep => { Writable => 'boolean' },
    Role => { }, VerticalFocus => { }, FeedFocus => { }, BestIn => { Writable => 'real' },
    BestOut => { Writable => 'real' }, ViewYaw => { Writable => 'real' }, Issues => { List => 'Bag' },
    EditNotes => { }, EditStatus => { }, EditFile => { }, Reels => { List => 'Bag' },
    SequenceStyle => { }, SequenceFps => { Writable => 'integer' },
);
1;
