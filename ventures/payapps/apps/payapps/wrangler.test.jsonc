// Test-only Worker config used by vitest.worker.config.ts (no static assets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payapps",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [{ "binding": "DB", "database_name": "payapps", "database_id": "local-test" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "payapps-files-test" }],
  "vars": {
    "APP_ENV": "test",
    "APP_URL": "http://localhost:5173",
    "BILLING_PROVIDER": "none"
  }
}
