// PayPencil marketing site: one Cloudflare Worker serving the static pages from dist/ (built by
// scripts/build.ts) plus the early-access API. D1 is auto-provisioned by `wrangler deploy` when no
// database_id is given. Use full-line comments only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "payapps-site",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "preview_urls": false,
  // dist/ holds the pages under the base path directory (dist/payapps/... in production), so the
  // URL path maps straight to the file. Only the API runs the Worker first.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/payapps/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "payapps-site",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Email Service, as in apps/grants (docs/EMAIL.md there). Transactional only: the
  // double opt-in confirmation. The sender domain must be onboarded before EMAIL_MODE=cloudflare.
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    {
      "name": "EARLY_ACCESS_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Daily: delete sign-ups never confirmed within 30 days.
  "triggers": { "crons": ["41 4 * * *"] },
  "vars": {
    "APP_ENV": "development",
    "SITE_URL": "http://localhost:8787",
    "EMAIL_FROM": "PayPencil <no-reply@example.org>",
    "EMAIL_MODE": "log"
  }
}
