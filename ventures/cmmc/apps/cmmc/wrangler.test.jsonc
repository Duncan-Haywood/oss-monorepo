// Test-only Worker config used by vitest.worker.config.ts. Mirrors wrangler.jsonc minus static assets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cmmc-workspace",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "cmmc-workspace", "database_id": "local-test" }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cmmc-workspace-files" }],
  "vars": {
    "APP_ENV": "test",
    "APP_URL": "http://localhost:5173",
    "LLM_MODEL": "claude-haiku-5-5",
    "FAKE_EXTERNALS": "true"
  }
}
