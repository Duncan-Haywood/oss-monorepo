  <info>
    <title>Doors and windows carry their base quantities (geometry fill check)</title>
    <description>Doors and windows carry Qto_DoorBaseQuantities / Qto_WindowBaseQuantities Width, Height, Area and Perimeter, as a door and window schedule or a glazing takeoff reads them. Written for eval/door-window-quantities-2026-11-22.md; MIT.</description>
  </info>
  <specifications>
    <specification name="Doors carry a width" ifcVersion="IFC2X3 IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCDOOR</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCLENGTHMEASURE"><propertySet><simpleValue>Qto_DoorBaseQuantities</simpleValue></propertySet><baseName><simpleValue>Width</simpleValue></baseName></property>
      </requirements>
    </specification>
