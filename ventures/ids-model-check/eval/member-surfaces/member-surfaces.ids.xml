  <info>
    <title>Linear members carry their surface areas (geometry fill check)</title>
    <description>Beams, columns, members and piles carry Qto_ OuterSurfaceArea and GrossSurfaceArea, as a coating, fire protection or galvanising takeoff reads them. Written for eval/member-surfaces-2026-11-22.md; MIT.</description>
  </info>
  <specifications>
    <specification name="Beams carry an outer surface area" ifcVersion="IFC2X3 IFC4">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity><name><simpleValue>IFCBEAM</simpleValue></name></entity>
      </applicability>
      <requirements>
        <property dataType="IFCAREAMEASURE"><propertySet><simpleValue>Qto_BeamBaseQuantities</simpleValue></propertySet><baseName><simpleValue>OuterSurfaceArea</simpleValue></baseName></property>
      </requirements>
    </specification>
