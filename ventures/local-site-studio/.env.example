# App
# Also used as the canonical origin for SEO: sitemap.xml, robots.txt, and
# preview page canonical/Open Graph URLs (src/lib/seo.ts). Set to the real
# production domain before launch — otherwise these point at localhost.
# Until set to a non-localhost public origin, /dashboard shows an orange
# banner via assessAppUrlEnvReadiness (src/lib/seo/app-url-env-readiness.ts).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator dashboard auth — required before real lead data / outreach at scale
# When unset, /dashboard stays open (demo). When set, proxy + server actions require login.
# OPERATOR_DASHBOARD_PASSWORD=

# Two-layer branding
# Public brand — customer-facing (marketing, outreach, voice agent). Set before launch.
NEXT_PUBLIC_BRAND_NAME=
# Legal entity — Stripe, contracts, compliance (do not change without counsel)
NEXT_PUBLIC_LEGAL_ENTITY=Maris Stella Labs
NEXT_PUBLIC_LEGAL_LOCATION=Colorado, USA
# Optional: DBA / trade name filed with Colorado Secretary of State
# NEXT_PUBLIC_DBA_NAME=

# CAN-SPAM requires a valid physical postal address in outreach emails.
# Until set to a non-placeholder address, /dashboard shows a yellow
# readiness banner via assessCompanyAddressEnvReadiness
# (src/lib/brand/company-address-env-readiness.ts).
NEXT_PUBLIC_COMPANY_ADDRESS=[Registered business address — Colorado, USA]
NEXT_PUBLIC_SUPPORT_EMAIL=support@marisstella.app

# Stripe — merchant account: Maris Stella Labs (legal entity)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Not required: every checkout (bundle + Commerce Buy now) redirects to a
# Stripe-hosted Checkout Session URL server-side — no @stripe/stripe-js /
# loadStripe call site exists that would read a publishable key. Only add
# this if a future embedded/Elements checkout flow needs it.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs — one per bundle tier (see /docs/product-bundles and src/lib/pricing/bundles.ts)
STRIPE_PRICE_ID_STARTER_SETUP=price_...
STRIPE_PRICE_ID_GROWTH_SETUP=price_...
STRIPE_PRICE_ID_GROWTH_MONTHLY=price_...
STRIPE_PRICE_ID_COMPLETE_SETUP=price_...
STRIPE_PRICE_ID_COMPLETE_MONTHLY=price_...
STRIPE_PRICE_ID_COMMERCE_SETUP=price_...
STRIPE_PRICE_ID_COMMERCE_MONTHLY=price_...
# Annual billing option (Growth/Complete only — see annual-billing-option). Optional:
# checkout falls back to monthly if unset. Not combinable with the Commerce add-on.
STRIPE_PRICE_ID_GROWTH_ANNUAL=price_...
STRIPE_PRICE_ID_COMPLETE_ANNUAL=price_...
# One-shot Price creation: set to 1, POST /api/stripe/bootstrap-prices, paste envSnippet, then unset
# ALLOW_STRIPE_BOOTSTRAP=1
# Billing Portal (Growth/Complete/Commerce): activate Customer Portal in Stripe Dashboard
# (Settings → Billing → Customer portal). No extra env vars — uses STRIPE_SECRET_KEY.
# Customer: POST /api/stripe/billing-portal { sessionId }. Operator: Billing on /dashboard/leads.

# Dormant Connect Express account-creation scaffold (commerce-payouts-stripe-connect) — account
# creation + status-checking only, no payout/transfer wiring. Leave unset until ready to create
# per-client Connect accounts from the Payouts panel on /dashboard/leads.
# ALLOW_STRIPE_CONNECT_ONBOARDING=1

# Preview / production hosting (Vercel)
# Until VERCEL_TOKEN is a non-placeholder secret, /dashboard shows a blue
# readiness banner (assessVercelTokenEnvReadiness) — Domains API otherwise skips.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
# Shared project fallback for tryProvisionVercelDomain when a handoff has no
# per-client Assign project id. Until set to a non-placeholder id, /dashboard
# shows an indigo readiness banner (assessVercelProjectIdEnvReadiness).
VERCEL_PROJECT_ID=
NEXT_PUBLIC_PREVIEW_DOMAIN=preview.localsitestudio.com
# Optional root for suggested production hosts ({slug}.yoursite.com).
# Until set to a bare public root, /dashboard shows a cyan readiness banner.
# NEXT_PUBLIC_PRODUCTION_DOMAIN=localsitestudio.com

# Email outreach — From name uses public brand; footer identifies legal entity (CAN-SPAM)
# Until EMAIL_FROM is a non-placeholder Resend-verified address, /dashboard shows a
# lime readiness banner via assessEmailFromEnvReadiness
# (src/lib/email/email-from-env-readiness.ts). sendEmail / sendOperatorDailyDigest
# use brand.emailFrom for the Resend `from` header (never a hardcoded platform domain).
EMAIL_FROM=noreply@marisstella.app
RESEND_API_KEY=re_...

# Resend delivery-event webhook (POST /api/resend/webhook) — hard bounces
# and spam complaints auto-suppress the recipient, protecting sender
# reputation for every future send. Dormant (endpoint returns 501) until
# set. In the Resend dashboard: Webhooks -> Add Endpoint -> URL
# https://yourdomain.com/api/resend/webhook -> select "email.bounced" and
# "email.complained" -> copy the Signing Secret here. See
# /docs/launch-checklist.
# RESEND_WEBHOOK_SECRET=whsec_...

# Operator daily digest — recipient for the "Send daily digest" button on
# /dashboard/leads (Work next, follow-ups due, abandoned-checkout recoveries,
# unreplied inquiries). Uses RESEND_API_KEY above; no separate email service.
# OPERATOR_DIGEST_EMAIL=you@example.com

# Automates the daily digest above via GET /api/cron/daily-digest,
# abandoned-checkout/Buy-now-cart recovery emails via
# GET /api/cron/checkout-recovery, AND cold-outreach Email 2/3 follow-ups via
# GET /api/cron/outreach-followups — all three are wired as separate "crons"
# entries in vercel.json and share this one secret. Without it, each only
# ever sends when an operator remembers to click its dashboard button.
# Generate any long random token (e.g. `openssl rand -hex 32`); Vercel Cron
# automatically sends it back as `Authorization: Bearer <value>` when the env
# var is named exactly CRON_SECRET. NOTE: Vercel's Hobby plan allows only 2
# Cron Jobs total — three routes needs a Pro plan (or higher) project; on
# Hobby, drop one "crons" entry in vercel.json or upgrade. See
# /docs/launch-checklist.
# CRON_SECRET=

# Voice agent — introduce with public brand name (see /docs/voice-agent-flow)
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_WEBHOOK_SECRET=
# VOICE_INBOUND_NUMBER=+1...
# VOICE_OUTBOUND_CALLER_ID=+1...

# Database — Convex (chosen; see /docs/process business decisions)
# Until NEXT_PUBLIC_CONVEX_URL is a non-placeholder deployment URL, /dashboard
# shows a pink multi-instance persistence banner (SQLite-only is fine for solo
# local demos; required before first paid order on Vercel / multi-instance).
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# CONVEX_AGENT_MODE=anonymous
# Convex query/mutation functions built with the plain query/mutation
# builders are public HTTP-callable RPCs — anyone with the deployment URL can
# call them directly, bypassing this app's own auth/rate-limiting entirely
# (see convex-public-function-api-secret in /docs/process). Functions
# migrated to requireApiSecret (convex/lib/apiSecret.ts) reject every call
# unless it carries this exact value. Set the SAME value in TWO places:
# (1) this app's hosting env as CONVEX_API_SECRET (server-only — never
#     NEXT_PUBLIC_-prefixed), and (2) the Convex deployment's own env vars
# (Convex dashboard → Settings → Environment Variables, or
# `npx convex env set CONVEX_API_SECRET <value>`) — these are two separate
# env stores. Generate with e.g. `openssl rand -hex 32`. Until both sides
# match, every migrated Convex function fails closed and that module falls
# back to SQLite (same degraded-but-safe path as a Convex outage).
# CONVEX_API_SECRET=

# Optional: AI site generation / voice LLM / marketing content
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...   # Enables real monthly marketing packs (else stub)

# Marketing scheduling (Phase 6 — see /docs/marketing-automation)
# Dormant Buffer auto-posting scaffold (marketing-content-scheduling) — lists the
# operator's own Buffer profiles and auto-posts facebook_caption/instagram_caption
# marketing pack variants to whichever profiles the operator maps a lead to, from
# the Marketing pack panel on /dashboard/leads. No per-lead OAuth: BUFFER_ACCESS_TOKEN
# is the operator's own long-lived Buffer access token (buffer.com/developers/apps).
# Leave unset until ready to auto-post.
# ALLOW_MARKETING_SCHEDULING=1
# BUFFER_ACCESS_TOKEN=
# GOOGLE_BUSINESS_PROFILE_*=  # OAuth credentials when direct GBP API is enabled — still fully gated
# META_*=                     # Facebook/Instagram OAuth when direct Meta API is enabled — still fully gated

# Error tracking (see /docs/architecture#observability) — dormant, vendor-agnostic scaffold.
# Until ERROR_TRACKING_WEBHOOK_URL is set, every failure path (the Stripe webhook's outer
# catch-all included) keeps logging only via console.error, exactly as before this shipped.
# Point it at any HTTP(S) endpoint that accepts a JSON POST — a custom receiver, a
# Datadog/Honeycomb log-intake URL, a Sentry-compatible ingestion proxy, etc.
# ERROR_TRACKING_WEBHOOK_URL=
# Optional bearer secret sent as `Authorization: Bearer <value>` (never the URL/body).
# ERROR_TRACKING_WEBHOOK_SECRET=
