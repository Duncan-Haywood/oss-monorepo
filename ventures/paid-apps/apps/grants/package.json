{
  "name": "grant-autopilot",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "vite preview",
    "provision": "node scripts/provision.mjs",
    "db:local": "scripts/local-db.sh",
    "demo": "scripts/demo.sh",
    "cf-typegen": "wrangler types --strict-vars=false --env-interface CloudflareBindings src/worker/worker-configuration.d.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:worker",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:e2e": "playwright test --trace off",
    "db:generate": "drizzle-kit generate",
    "db:export": "drizzle-kit export --sql",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.10.0",
    "@hono/zod-validator": "0.9.1",
    "@tanstack/react-query": "5.108.1",
    "@tanstack/react-router": "1.170.46",
    "better-auth": "1.7.26",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "hono": "4.13.19",
    "lucide-react": "1.76.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/vitest-plugin": "1.8.5",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "0.31.11",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.165.0"
  }
}
