# This deployment's own absolute origin, e.g. https://atelier.marisstella.dev
# (the host platform/k8s/apps/print-atelier/ingress.yaml serves). It is the
# origin of every URL in sitemap.xml, the `sitemap:` line in robots.txt, and the
# `link`/`imageLink` of every product pushed to Meta, Google Merchant Center and
# Pinterest.
#
# There is no default on purpose. It used to fall back to
# `https://printatelier.com`, which this portfolio does not own, so unset meant
# publishing a merchant feed and a sitemap for someone else's domain. Unset now
# means publish nothing: robots.txt disallows crawling, sitemap.xml is empty,
# and /api/ad-catalog/sync answers 503.
#
# Next.js inlines NEXT_PUBLIC_* at build time, so setting this in a running
# container does nothing — it has to be present for `next build`. In the
# container image that is the Dockerfile build arg of the same name.
NEXT_PUBLIC_SITE_URL=

# Operator token for internal API routes (currently /api/credentials/vercel-pull).
# Send it as `Authorization: Bearer <token>`. Those routes read the live process
# environment, so they fail closed: while this is unset every request is refused
# with 503 rather than served to anonymous callers. Generate with
# `openssl rand -hex 32`.
PRINT_ATELIER_OPS_TOKEN=

# Stripe Connect (test mode) — required for /api/stripe/webhook and /api/stripe/checkout
# Create at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`
STRIPE_WEBHOOK_SECRET=whsec_...

# Connect settings → OAuth → client ID
STRIPE_CONNECT_CLIENT_ID=ca_...

# Stripe automatic tax calculation (0 or 1)
STRIPE_AUTOMATIC_TAX=0

# Fulfillment (Printful / Gelato)
PRINTFUL_API_KEY=
PRINTFUL_STORE_ID=
GELATO_API_KEY=
GELATO_STORE_ID=

# Ad platforms
META_PIXEL_ID=
META_CATALOG_ID=
META_ACCESS_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_ACCESS_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_MERCHANT_CENTER_ID=
PINTEREST_AD_ACCOUNT_ID=
PINTEREST_ACCESS_TOKEN=
