# Wrangler local development secrets (do not commit real values)
AUTH_SECRET=generate-a-long-random-string-here

# Set after enabling Cloudflare Access on workers.dev:
# TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# POLICY_AUD=your-access-application-aud-tag

# Optional Google OAuth fallback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
