# Auth (required in production)
AUTH_SECRET=generate-a-long-random-string-here

# Google OAuth (optional — for local dev / fallback auth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare Access (recommended for production whitelist)
# Official Cloudflare env var names (set after enabling Access on workers.dev):
TEAM_DOMAIN=
POLICY_AUD=

# Legacy aliases (still supported):
CLOUDFLARE_ACCESS_ENABLED=true
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=

# Sign-in allowlist. Comma-separated; case and surrounding spaces do not
# matter. The app reads this variable per request, so changing it takes effect
# without a code change. Unset or empty denies everyone — it is never read as
# "allow all", and there is no built-in address to fall back to.
# In production the same variable is a Worker var in wrangler.jsonc.
ALLOWED_EMAIL=duncan.andrew.haywood@gmail.com

# Newsletter signups (/subscribe and POST /api/subscribe)
# Until SUBSCRIBER_WEBHOOK_URL is set the signup form answers 501 and tells the
# visitor their address was not kept — there is no subscriber store in this app,
# so a signup with nowhere to go is refused rather than silently discarded.
# Point it at a list provider's intake endpoint (Buttondown, ConvertKit, a
# Worker, an automation step); it receives POST {email, tier, interestSector}.
SUBSCRIBER_WEBHOOK_URL=
# Optional. Sent as `Authorization: Bearer <token>` when set.
SUBSCRIBER_WEBHOOK_TOKEN=
