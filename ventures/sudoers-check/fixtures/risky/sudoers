# A sudoers file with the mistakes this tool looks for.
Defaults env_reset
Defaults env_keep += "LD_PRELOAD PYTHONPATH"
Defaults timestamp_timeout=-1
Defaults:deploy !authenticate

User_Alias  OPS = alice, bob
Cmnd_Alias  LOGS = /usr/bin/less /var/log/*, /usr/bin/journalctl
Cmnd_Alias  SHELLS = /bin/sh, /bin/bash, /usr/bin/su

root    ALL=(ALL:ALL) ALL
%sudo   ALL=(ALL:ALL) ALL

OPS     ALL=(root) LOGS
carol   ALL=(ALL) ALL, !SHELLS
deploy  ALL=(root) /usr/bin/systemctl, /home/deploy/bin/release.sh
dave    ALL=(ALL) NOPASSWD: /usr/bin/vim /etc/nginx/nginx.conf
erin    ALL=(root) NOPASSWD: /bin/cat /var/log/app/*.log, /usr/bin/find
frank   ALL=(postgres) NOPASSWD: /usr/bin/psql
grace   ALL=(root) NOPASSWD: /usr/bin/apt-get update
heidi   ALL=(root) NOPASSWD: SETENV: /usr/local/bin/backup
ivan    ALL=(root) NOPASSWD: /usr/bin/whoami

@includedir /etc/sudoers.d
