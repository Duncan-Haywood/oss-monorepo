# Secrets for the team hub (wrangler.jsonc). The Deploy to Cloudflare button asks for these; with wrangler, run
# `npx wrangler secret put ADMIN_KEY` and `npx wrangler secret put TEAM_TOKEN`. Use long random strings (e.g. `openssl rand -hex 16`).
# ADMIN_KEY unlocks /admin?key=...; TEAM_TOKEN is the secret in the staff link /team?t=...
ADMIN_KEY=
TEAM_TOKEN=
# Optional: a Slack, Discord or ntfy webhook you own (README, "Alerts").
NOTIFY_WEBHOOK_URL=
TEAM_WEBHOOK_URL=
# Optional: the time clock (README, "Time clock and timesheets"). Your site's IANA zone (UTC if unset); TIME_CLOCK=0 turns it off.
TIMEZONE=
TIME_GRACE_MIN=5
# Optional: overtime and pay estimate on the timesheet (README, "Overtime, meal periods and rounding").
# PAY_RULES: federal (default), california, alaska or colorado. PUNCH_ROUND_MIN: 0 (off), 5, 6 or 15 (never under california).
PAY_RULES=federal
PUNCH_ROUND_MIN=0
