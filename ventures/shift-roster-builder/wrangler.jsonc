// The team hub as a Cloudflare Worker on the free plan (hub-worker.mjs). Deploy from your own fork or with the
// "Deploy to Cloudflare" button in README.md; set ADMIN_KEY and TEAM_TOKEN as secrets (.dev.vars.example).
{
  "name": "team-schedule-hub",
  "main": "hub-worker.mjs",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // calc.mjs and bnp.mjs are served to the admin page so the roster is built in the manager's browser.
  // .assetsignore (gitignore syntax) leaves every other file in this folder out of the upload.
  "assets": { "directory": "." },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "RosterHub" }] },
  // SQLite-backed Durable Objects are the kind the free plan offers.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RosterHub"] }]
}
