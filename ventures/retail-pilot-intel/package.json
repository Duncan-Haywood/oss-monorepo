{
  "name": "retail-pilot-intel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "eslint .",
    "ci": "tsx scripts/ci.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "docs:convert-html": "tsx scripts/convert-html-to-tsx.ts",
    "docs:dev": "pnpm --filter @retail-pilot/docs dev",
    "docs:build": "pnpm --filter @retail-pilot/docs build",
    "docs:export": "tsx scripts/export-docs-oneoff.ts",
    "portal:dev": "pnpm --filter @retail-pilot/portal dev",
    "portal:build": "pnpm --filter @retail-pilot/portal build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=22"
  }
}
