# Store
STORE_ID=pilot-leather-01
TZ=Europe/Rome

# Edge camera (LAN only — never commit real credentials)
RTSP_URL=rtsp://camera.local/stream1
EDGE_DEBUG_FRAMES=false

# Database
PILOT_DB_PATH=data/pilot.db

# POS inbox (CSV or JSON drops)
POS_INBOX_PATH=data/pos/inbox

# Private documentation site (apps/docs) — client-side gate; pair with Vercel Deployment Protection
VITE_DOCS_PASSCODE=pilot-docs
# VITE_DOCS_GATE_ENABLED=false   # force gate off (overrides prod default)
# VITE_DOCS_REQUIRE_AUTH=true    # force gate on in local dev (pnpm docs:dev)
# VITE_DOCS_SITE_URL=https://docs.retailpilotintel.com

# GitHub Actions: repository secret DOCS_PASSCODE for deploy-docs.yml

# Sales demo portal (client-side gate only — not production auth)
VITE_DEMO_PASSCODE=atelier-demo
# Optional: read-only KPI API for Overview (pnpm exec tsx packages/analytics/src/cli.ts serve-kpis)
# Leave unset to keep the portal on illustrative demoStore numbers.
# VITE_PILOT_API_URL=http://127.0.0.1:8787
