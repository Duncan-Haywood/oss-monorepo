+test("pairBreakFloor is the least breaks of two rounds alone, by brute force: byes, repeats, 1 to 7 matches", async () => {
+  // README "Stopping a refused trial early": the odd cycles of two consecutive rounds
+  const { pairBreakFloor } = await import("./orient.mjs");
+  const rand = mulberry32(77);
+  const roundOf = (n, sitOut) => {
+    const ts = [...Array(n).keys()];
+    for (let i = n - 1; i > 0; i--) { const j = Math.floor(rand() * (i + 1)); [ts[i], ts[j]] = [ts[j], ts[i]]; }
+    const ms = [];
+    for (let i = sitOut; i + 1 < n; i += 2) ms.push([Math.min(ts[i], ts[i + 1]), Math.max(ts[i], ts[i + 1])]);
+    return ms.sort((a, b) => a[0] - b[0]);
+  };
+  for (let it = 0; it < 400; it++) {
+    const n = 2 + Math.floor(rand() * 13);
+    const A = roundOf(n, Math.floor(rand() * 3)), B = it % 11 === 0 ? A.slice() : roundOf(n, Math.floor(rand() * 3));
+    let best = Infinity;
+    for (let x = 0; x < 1 << A.length; x++) for (let y = 0; y < 1 << B.length; y++) {
+      const home = new Map();
+      A.forEach(([a, b], i) => { home.set(a, (x >> i) & 1); home.set(b, 1 - ((x >> i) & 1)); });
+      let br = 0;
+      B.forEach(([c, d], j) => {
+        if (home.has(c) && home.get(c) === ((y >> j) & 1)) br++;
+        if (home.has(d) && home.get(d) === 1 - ((y >> j) & 1)) br++;
+      });
+      if (br < best) best = br;
+    }
+    if (!A.length || !B.length) best = 0;
+    assert.equal(pairBreakFloor(A, B), best, `A ${JSON.stringify(A)} B ${JSON.stringify(B)}`);
+  }
+});
+
+test("floorTable trials with a cutoff: the exact least at or under it, else a bound over it and at most the least; commits and walks after either unchanged", async () => {
+  // README "Stopping a refused trial early"
+  const { floorTable, MINPLUS_WASM_ON } = await import("./orient.mjs");
+  if (!MINPLUS_WASM_ON) return;
+  let stopped = 0, all = 0;
+  for (const n of [14, 20, 24, 28, 30]) {
+    const opp = oppOf(carryOverTry(n, 1, { seed: 3, weighted: 8 }).rounds, n), R = opp.length;
+    const a = floorTable(opp, n, { maxMatches: 15 }), b = floorTable(opp, n, { maxMatches: 15 });
+    for (let i = 0; i < 24; i++) {
+      const lo = (i * 5) % R, hi = Math.min(R - 1, lo + 1 + (i % 6) * 3);
+      [opp[lo], opp[hi]] = [opp[hi], opp[lo]];
+      const want = b.trial(lo, hi);
+      for (const cutoff of [want - 9, want - 3, want - 1, want, want + 2]) {
+        const got = a.trial(lo, hi, cutoff);
+        all++;
+        if (want <= cutoff) assert.equal(got, want, `${n} ${lo}..${hi} cutoff ${cutoff}`);
+        else { assert.ok(got > cutoff && got <= want, `${n} ${lo}..${hi} cutoff ${cutoff}: ${got} of ${want}`); if (got < want) stopped++; }
+      }
+      // the last trial (cutoff want + 2) was exact; one more with a low cutoff, then commit or walk
+      a.trial(lo, hi, want - 9);
+      if (i % 3 === 0) { a.commit(); b.trial(lo, hi); b.commit(); } else [opp[lo], opp[hi]] = [opp[hi], opp[lo]];
+      if (i % 4 === 1) {
+        a.trial(0, 1, -1); b.trial(0, 1);
+        assert.deepEqual(a.balanced(want + 6, { budget: 2000 }), b.balanced(want + 6, { budget: 2000 }), `${n} walk`);
+        a.commit(); b.commit();
+      }
+    }
+  }
+  // the bound did stop trials before their end
+  assert.ok(stopped > 0, `${stopped} of ${all}`);
+});
