# Copy to .env and fill in. Never commit .env.
PUBLIC_BASE_URL=https://nutrition.example.com
PORT=8787
# openssl rand -base64 32  (each at least 24 characters)
OWNER_PASSWORD=
DEVICE_TOKEN=
# Optional, comma-separated bearer tokens for a Custom GPT's Actions or scripts
API_TOKEN=
# Vision model (OpenAI or any OpenAI-compatible endpoint). Without a key, photos queue unanalysed.
NUTRITION_API_KEY=
NUTRITION_MODEL=gpt-5-mini
NUTRITION_API_BASE=https://api.openai.com/v1
DATABASE_PATH=./data/nutrition.sqlite
