[Unit]
Description=Poll configured repos for agent work and run it
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ agent_user }}
Environment=AGENT_RUNNER_USE_DOCKER={{ use_docker_sandbox | lower }}
Environment=AGENT_RUNNER_DOCKER_IMAGE=agent-runner:latest
ExecStart=/usr/bin/python3 /srv/agents/bin/agent_runner.py
StandardOutput=journal
StandardError=journal
# Belt-and-braces timeout in case a tool run hangs despite its own
# per-invocation timeout in agent_runner.py.
TimeoutStartSec=3600
