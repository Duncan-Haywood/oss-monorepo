{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-pilot-intel.local/schemas/sale_event.json",
  "title": "SaleEvent",
  "description": "Normalized POS basket. No card numbers or unnecessary customer PII.",
  "type": "object",
  "required": ["event_id", "store_id", "basket_id", "closed_at", "line_items", "currency"],
  "properties": {
    "event_id": { "type": "string", "format": "uuid" },
    "store_id": { "type": "string" },
    "basket_id": { "type": "string" },
    "closed_at": { "type": "string", "format": "date-time" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "EUR" },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sku", "quantity", "unit_price_cents"],
        "properties": {
          "sku": { "type": "string" },
          "quantity": { "type": "integer", "minimum": 1 },
          "unit_price_cents": { "type": "integer", "minimum": 0 },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "total_cents": { "type": "integer", "minimum": 0 },
    "payment_class": {
      "type": "string",
      "enum": ["cash", "card", "mixed", "other", "unknown"]
    },
    "pos_vendor": { "type": "string" },
    "raw_reference": {
      "type": "string",
      "description": "Opaque POS receipt id for support, not customer identity"
    }
  },
  "additionalProperties": false
}
