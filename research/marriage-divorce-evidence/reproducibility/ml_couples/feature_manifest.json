  "target": "Recorded legal-divorce events per observed person-year; event/exposure with sample_weight=baselineweight*exposure",
  "folds": "5 shuffled respondent-group heldout folds, seed20261019, same rows/folds for all six candidates",
  "core_features": [
    "both spouses schooling-year tiers",
    "training-wave combined wage quartile with Zero and Unknown distinct",
    "earnings role including Both zero and Unknown",
    "current age",
    "current marriage duration",
    "respondent sex",
    "first/subsequent/unknown marriage order",
    "baseline wave"
  ],
  "enriched_features": [
    "respondent exact degree report available at baseline",
    "respondent work-hour group",
    "own religious attendance measured2000/updated2012 only from2012 onward, Unknown retained",
    "age at first marriage",
    "wife wage share with Unknown indicator",
    "training-only family-income quartile",
    "training-only common husband/wife individual wage bands"
  ],
  "flexibility": "Quadratic splines with3trainingquantileknots for numeric predictors; school-pair and earnings-role\u00d7total-wage categorical interactions; fixed ridgealpha.0001",
  "penalties": {
    "Additive core": 0,
    "Additive enriched": 0.0001,
    "Spline + pair interactions": 0.0001
  },
  "tree_constraints": "Maximumdepth2/3; training-only escalation of minimum leaf rows until every leaf has20events and100distinctrespondents",
  "not_included": [
    "spouse religious agreement/practice",
    "religious belief strength",
    "race as a recommended trait",
    "wealth/assets/pensions/self-employment income as paired wage predictors",
    "occupation",
    "relationship quality",
    "infidelity",
    "politics"
  ],
