/-
  E16 (experiments/e16_model_theorems/results.md): the model counts that E13 and E14 checked by
  exhaustive search, proved for every block algebra and every domain assignment.

  Setting as E13–E15: S5, varying domains, a rigid positive set `P` of properties (predicates on
  the blocks `K` of a partition of world x individual cells), actualist entailment and actualist
  "x has f necessarily" (`NecA`), Anderson's own A2 (`A2w`).

  Write `hE x` for the blocks meeting `x`'s existing cells (`Closure.hE`).  For a set of blocks
  `H`, write `Same H y` for "`hE y` is exactly `H`" (the individuals that would be God-like if the
  positive properties were those containing `H`).

  Results:
  (1) `model_iff` (E13 (a)): `P` satisfies A1, A2w and A3' exactly when there is a non-empty `H`
      with `P = {f : H ⊆ f}`, every cell of `H` in the row of some `y` with `Same H y`
      (`H ⊆ G(H)`), and the cells of those `y` forming a property (`G(H)` a union of blocks);
  (2) `godlike_iff`: in such a model the God-like individuals are exactly the `y` with `Same H y`;
  (3) `a5a_iff` (E13 (b)): such a model satisfies A5' exactly when the Anderson-necessary
      individuals' cells form a property and every cell of `H` belongs to one;
  (4) `a5z_iff` (E14 (c)): it satisfies A5₀ exactly when the cells of the individuals existing at
      every world form a property and every cell of `H` belongs to one;
  (5) `positive_set_unique`: a model's positive set is determined by `H`, and `H` by any one
      God-like individual, so the models of a frame correspond one-to-one to the admissible `H`.
  Core Lean 4 only.
-/
import TheismFormal.Closure

namespace TheismFormal.Models
open TheismFormal.Anderson TheismFormal.Varying TheismFormal.Actualist TheismFormal.Plain
  TheismFormal.Closure

variable {W D K : Type}

/-- `hE y` is exactly `H`. -/
def Same (blk : W × D → K) (Ex : W × D → Prop) (H : K → Prop) (y : D) : Prop :=
  ∀ k, hE blk Ex y k ↔ H k

/-- The positive set generated by `H`: the properties containing every block of `H`. -/
def Up (H : K → Prop) : (K → Prop) → Prop := fun f => ∀ k, H k → f k

/-- The admissibility conditions of E13 (a) on a set of blocks `H`. -/
structure Admissible (blk : W × D → K) (Ex : W × D → Prop) (H : K → Prop) : Prop where
  nonempty : ∃ k, H k
  sub : ∀ c, H (blk c) → Same blk Ex H c.2
  closed : ∃ g : K → Prop, ∀ c, g (blk c) ↔ Same blk Ex H c.2

theorem necA_iff (blk : W × D → K) (Ex : W × D → Prop) (f : K → Prop) (x : D) :
    NecA blk Ex f x ↔ ∀ k, hE blk Ex x k → f k :=
  ⟨fun h _ ⟨v, hv, heq⟩ => heq ▸ h v hv, fun h w hw => h _ ⟨w, hw, rfl⟩⟩

/-- Two sets of blocks generate the same positive set only if they are equal (pointwise). -/
theorem up_inj (H H' : K → Prop) (h : ∀ f, Up H f ↔ Up H' f) : ∀ k, H k ↔ H' k :=
  fun k => ⟨fun hk => (h H').2 (fun _ h => h) k hk, fun hk => (h H).1 (fun _ h => h) k hk⟩

/-- **(2)** With positive set `Up H`, `y` is God-like iff `hE y` is exactly `H`. -/
theorem godlike_iff (blk : W × D → K) (Ex : W × D → Prop) (H : K → Prop) (y : D) :
    GStarA blk Ex (Up H) y ↔ Same blk Ex H y := by
  constructor
  · intro h
    have : ∀ f, Up (hE blk Ex y) f ↔ Up H f := fun f =>
      ((necA_iff blk Ex f y).symm.trans (h f).symm)
    exact up_inj _ _ this
  · intro h f
    rw [necA_iff]
    exact ⟨fun hf k hk => hf k ((h k).1 hk), fun hf k hk => hf k ((h k).2 hk)⟩

/-- A God-like individual's `hE` generates the positive set. -/
theorem positive_eq_up (blk : W × D → K) (Ex : W × D → Prop) (P : (K → Prop) → Prop)
    (x : D) (hx : GStarA blk Ex P x) : ∀ f, P f ↔ Up (hE blk Ex x) f :=
  fun f => (hx f).trans (necA_iff blk Ex f x)

/-- **(1) E13 (a), soundness.**  Every admissible `H` gives a model of A1, A2w and A3'. -/
theorem model_of_admissible (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (H : K → Prop) (hH : Admissible blk Ex H) :
    A1v blk Ex (Up H) ∧ A2w (Up H) ∧ A3a blk Ex (Up H) := by
  obtain ⟨⟨k0, hk0⟩, sub, ⟨g, hg⟩⟩ := hH
  refine ⟨?_, ?_, ?_⟩
  · -- every block of `H` contains an existing cell, so an entailment preserves `H ⊆ f`
    intro f f' hf hent k hk
    obtain ⟨c, rfl⟩ := onto k
    obtain ⟨v, hv, heq⟩ := ((sub c hk) (blk c)).2 hk
    have := hent (v, c.2) hv (heq ▸ hf _ hk)
    exact heq ▸ this
  · intro f hf hnf
    exact hnf k0 hk0 (hf k0 hk0)
  · refine ⟨g, ?_, fun c => (hg c).trans (godlike_iff blk Ex H c.2).symm⟩
    intro k hk
    obtain ⟨c, rfl⟩ := onto k
    exact (hg c).2 (sub c hk)

/-- **(1) E13 (a), completeness.**  Every model of A1, A2w and A3' is `Up H` for an admissible
    `H`, namely `hE x` of any God-like `x`. -/
theorem admissible_of_model (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (P : (K → Prop) → Prop) (h1 : A1v blk Ex P) (h2 : A2w P) (h3 : A3a blk Ex P) :
    ∃ H, Admissible blk Ex H ∧ ∀ f, P f ↔ Up H f := by
  obtain ⟨x, hx⟩ := exists_godlikeA blk Ex onto P h1 h2 h3
  obtain ⟨w1, hw1⟩ := godlike_exists_somewhere blk Ex P h2 x hx
  have hP := positive_eq_up blk Ex P x hx
  have gs : ∀ y, GStarA blk Ex P y ↔ Same blk Ex (hE blk Ex x) y := fun y =>
    ⟨fun hy => (godlike_iff blk Ex _ y).1 (fun f => (hP f).symm.trans (hy f)),
     fun hy f => (hP f).trans ((godlike_iff blk Ex _ y).2 hy f)⟩
  obtain ⟨g, hg, hgc⟩ := h3
  refine ⟨hE blk Ex x, ⟨⟨_, w1, hw1, rfl⟩, ?_, ⟨g, fun c => (hgc c).trans (gs c.2)⟩⟩, hP⟩
  intro c hc
  exact (gs c.2).1 ((hgc c).1 ((hP g).1 hg _ hc))

/-- **(1) E13 (a).**  `P` is a model of A1, A2w and A3' iff it is `Up H` for an admissible `H`. -/
theorem model_iff (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (P : (K → Prop) → Prop) :
    (A1v blk Ex P ∧ A2w P ∧ A3a blk Ex P) ↔
      ∃ H, Admissible blk Ex H ∧ ∀ f, P f ↔ Up H f := by
  constructor
  · intro ⟨h1, h2, h3⟩
    exact admissible_of_model blk Ex onto P h1 h2 h3
  · intro ⟨H, hH, hP⟩
    obtain ⟨m1, m2, ⟨g, hg, hgc⟩⟩ := model_of_admissible blk Ex onto H hH
    have gs : ∀ y, GStarA blk Ex P y ↔ GStarA blk Ex (Up H) y := fun y =>
      ⟨fun hy f => (hP f).symm.trans (hy f), fun hy f => (hP f).trans (hy f)⟩
    refine ⟨fun f f' hf he => (hP f').2 (m1 f f' ((hP f).1 hf) he),
      fun f hf hnf => m2 f ((hP f).1 hf) ((hP _).1 hnf),
      ⟨g, (hP g).2 hg, fun c => (hgc c).trans (gs c.2).symm⟩⟩

/-- **(5)** Two God-like individuals of a model generate the same `H`, so a model's positive set
    and its `H` determine each other. -/
theorem positive_set_unique (blk : W × D → K) (Ex : W × D → Prop) (P : (K → Prop) → Prop)
    (x y : D) (hx : GStarA blk Ex P x) (hy : GStarA blk Ex P y) :
    ∀ k, hE blk Ex x k ↔ hE blk Ex y k :=
  up_inj _ _ (fun f => (positive_eq_up blk Ex P x hx f).symm.trans
    (positive_eq_up blk Ex P y hy f))

/-- A property `n` holding at exactly the cells of the individuals satisfying `Q` is positive in
    `Up H` iff every cell of `H` belongs to such an individual. -/
theorem up_row_iff (blk : W × D → K) (onto : ∀ k, ∃ c, blk c = k) (H : K → Prop)
    (Q : D → Prop) (n : K → Prop) (hn : ∀ c, n (blk c) ↔ Q c.2) :
    Up H n ↔ ∀ c, H (blk c) → Q c.2 := by
  constructor
  · intro h c hc
    exact (hn c).1 (h _ hc)
  · intro h k hk
    obtain ⟨c, rfl⟩ := onto k
    exact (hn c).2 (h c hk)

/-- **(3) E13 (b).**  `Up H` satisfies A5' iff the Anderson-necessary individuals' cells form a
    property and every cell of `H` belongs to one (`NEa` itself is `Closure.nea_iff`). -/
theorem a5a_iff (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (H : K → Prop) :
    A5a blk Ex (Up H) ↔
      (∃ m : K → Prop, ∀ c, m (blk c) ↔ NEa blk Ex c.2) ∧ ∀ c, H (blk c) → NEa blk Ex c.2 := by
  constructor
  · intro ⟨n, hn, hnc⟩
    exact ⟨⟨n, hnc⟩, (up_row_iff blk onto H _ n hnc).1 hn⟩
  · intro ⟨⟨m, hm⟩, hsub⟩
    exact ⟨m, (up_row_iff blk onto H _ m hm).2 hsub, hm⟩

/-- **(4) E14 (c).**  `Up H` satisfies A5₀ iff the cells of the individuals existing at every
    world form a property and every cell of `H` belongs to one. -/
theorem a5z_iff (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (H : K → Prop) :
    A5z blk Ex (Up H) ↔
      (∃ m : K → Prop, ∀ c, m (blk c) ↔ NE0 Ex c.2) ∧ ∀ c, H (blk c) → NE0 Ex c.2 := by
  constructor
  · intro ⟨n, hn, hnc⟩
    exact ⟨⟨n, hnc⟩, (up_row_iff blk onto H _ n hnc).1 hn⟩
  · intro ⟨⟨m, hm⟩, hsub⟩
    exact ⟨m, (up_row_iff blk onto H _ m hm).2 hsub, hm⟩

/-- **E14 (c), assembled.**  The models of A1, A2w, A3' and A5₀ are exactly the `Up H` with `H`
    admissible, the everywhere-existents' cells a property, and `H` inside them. -/
theorem model_a5z_iff (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (P : (K → Prop) → Prop) :
    (A1v blk Ex P ∧ A2w P ∧ A3a blk Ex P ∧ A5z blk Ex P) ↔
      ∃ H, Admissible blk Ex H ∧ (∀ f, P f ↔ Up H f) ∧
        (∃ m : K → Prop, ∀ c, m (blk c) ↔ NE0 Ex c.2) ∧ ∀ c, H (blk c) → NE0 Ex c.2 := by
  have tr : ∀ H, (∀ f, P f ↔ Up H f) → (A5z blk Ex P ↔ A5z blk Ex (Up H)) := fun H hP =>
    ⟨fun ⟨n, hn, hnc⟩ => ⟨n, (hP n).1 hn, hnc⟩, fun ⟨n, hn, hnc⟩ => ⟨n, (hP n).2 hn, hnc⟩⟩
  constructor
  · intro ⟨h1, h2, h3, h5⟩
    obtain ⟨H, hH, hP⟩ := (model_iff blk Ex onto P).1 ⟨h1, h2, h3⟩
    exact ⟨H, hH, hP, (a5z_iff blk Ex onto H).1 ((tr H hP).1 h5)⟩
  · intro ⟨H, hH, hP, h5⟩
    obtain ⟨h1, h2, h3⟩ := (model_iff blk Ex onto P).2 ⟨H, hH, hP⟩
    exact ⟨h1, h2, h3, (tr H hP).2 ((a5z_iff blk Ex onto H).2 h5)⟩

/-- **E13 (a)+(b), assembled.**  The same for A5'. -/
theorem model_a5a_iff (blk : W × D → K) (Ex : W × D → Prop) (onto : ∀ k, ∃ c, blk c = k)
    (P : (K → Prop) → Prop) :
    (A1v blk Ex P ∧ A2w P ∧ A3a blk Ex P ∧ A5a blk Ex P) ↔
      ∃ H, Admissible blk Ex H ∧ (∀ f, P f ↔ Up H f) ∧
        (∃ m : K → Prop, ∀ c, m (blk c) ↔ NEa blk Ex c.2) ∧ ∀ c, H (blk c) → NEa blk Ex c.2 := by
  have tr : ∀ H, (∀ f, P f ↔ Up H f) → (A5a blk Ex P ↔ A5a blk Ex (Up H)) := fun H hP =>
    ⟨fun ⟨n, hn, hnc⟩ => ⟨n, (hP n).1 hn, hnc⟩, fun ⟨n, hn, hnc⟩ => ⟨n, (hP n).2 hn, hnc⟩⟩
  constructor
  · intro ⟨h1, h2, h3, h5⟩
    obtain ⟨H, hH, hP⟩ := (model_iff blk Ex onto P).1 ⟨h1, h2, h3⟩
    exact ⟨H, hH, hP, (a5a_iff blk Ex onto H).1 ((tr H hP).1 h5)⟩
  · intro ⟨H, hH, hP, h5⟩
    obtain ⟨h1, h2, h3⟩ := (model_iff blk Ex onto P).2 ⟨H, hH, hP⟩
    exact ⟨h1, h2, h3, (tr H hP).2 ((a5a_iff blk Ex onto H).2 h5)⟩

end TheismFormal.Models
