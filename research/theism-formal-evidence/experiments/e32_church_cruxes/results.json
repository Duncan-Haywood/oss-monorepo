 "claims": [
  {
   "id": "a2",
   "side": "shared",
   "text": "What an ecumenical council defines cannot be in error",
   "formula": "Ay.(Ecumenical(y) -> ~Erred(y))",
   "source": "common to both: Orthodox for the seven councils, Catholic for the twenty-one"
  },
  {
   "id": "c2",
   "side": "shared",
   "text": "What an ecumenical council condemns as heresy is error",
   "formula": "Az.(Condemned(z) -> Erred(z))",
   "source": "E1 claim c2"
  },
  {
   "id": "c3",
   "side": "shared",
   "text": "Constantinople III condemned Honorius's letter as heresy",
   "formula": "Condemned(h)",
   "source": "Constantinople III (681), 13th session"
  },
  {
   "id": "fL",
   "side": "shared",
   "text": "Lyon II defined the Filioque",
   "formula": "(~Filioque -> Erred(lyon2))",
   "source": "Lyon II (1274), constitution on the procession of the Holy Spirit (unchecked)"
  },
  {
   "id": "fF1",
   "side": "shared",
   "text": "Florence defined the Filioque",
   "formula": "(~Filioque -> Erred(flor))",
   "source": "Florence, Laetentur caeli (1439) (unchecked)"
  },
  {
   "id": "fF2",
   "side": "shared",
   "text": "Florence defined purgatory",
   "formula": "(~Purgatory -> Erred(flor))",
   "source": "Florence, Laetentur caeli (1439) (unchecked)"
  },
  {
   "id": "fF3",
   "side": "shared",
   "text": "Florence defined the primacy of the Roman pontiff",
   "formula": "(~Primacy -> Erred(flor))",
   "source": "Florence, Laetentur caeli (1439) (unchecked)"
  },
  {
   "id": "fT",
   "side": "shared",
   "text": "Trent defined purgatory",
   "formula": "(~Purgatory -> Erred(trent))",
   "source": "Trent, session 25, decree on purgatory (1563) (unchecked)"
  },
  {
   "id": "fV3",
   "side": "shared",
   "text": "Vatican I defined Roman primacy of jurisdiction",
   "formula": "(~Primacy -> Erred(v1))",
   "source": "Vatican I, Pastor Aeternus ch. 3 (1870) (unchecked)"
  },
  {
   "id": "fV4",
   "side": "shared",
   "text": "Vatican I defined papal infallibility",
   "formula": "(~Ax.(ExCathedra(x) -> ~Erred(x)) -> Erred(v1))",
   "source": "Vatican I, Pastor Aeternus ch. 4 (1870) (unchecked)"
  },
  {
   "id": "fI",
   "side": "shared",
   "text": "Ineffabilis Deus defined the Immaculate Conception",
   "formula": "(~ImmConc -> Erred(ineff))",
   "source": "Pius IX, Ineffabilis Deus (1854) (unchecked)"
  },
  {
   "id": "fM",
   "side": "shared",
   "text": "Munificentissimus Deus defined the Assumption",
   "formula": "(~Assumption -> Erred(munif))",
   "source": "Pius XII, Munificentissimus Deus (1950) (unchecked)"
  },
  {
   "id": "a1",
   "side": "catholic",
   "text": "What a pope defines ex cathedra cannot be in error",
   "formula": "Ax.(ExCathedra(x) -> ~Erred(x))",
   "source": "Vatican I, Pastor Aeternus ch. 4 (1870)"
  },
  {
   "id": "sL",
   "side": "catholic",
   "text": "Lyon II was ecumenical",
   "formula": "Ecumenical(lyon2)",
   "source": "Catholic numbering: 14th council"
  },
  {
   "id": "sF",
