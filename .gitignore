.DS_Store
*.log

# Environments — never commit secrets. Each venture scopes its own.
.env
.env.*
!.env.example
.venv/
venv/

node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

dist/
build/
.next/
out/
coverage/

tmp/
.tmp/

# Local git-worktree scaffolding created by Claude Code's Agent tool
# (isolation: "worktree"). Transient per-session tooling state, not content.
/.claude/worktrees/
/.claude/settings.local.json

# OpenTofu (infra/)
**/.terraform/
**/*.tfstate
**/*.tfstate.*
infra/*.tfvars
!infra/terraform.tfvars.example

# Built GitHub Pages sites. Regenerated on every deploy; never committed.
# `platform/pages/dist/` is what actually publishes (build.mjs, the documented
# local command builds into it, ~230 files); `_site/` is the second builder's
# output (platform/ci/build_pages_site.py), kept as a cross-check.
/_site/
/platform/pages/dist/
/dist/
.tmp/

# Shell-probe debris. Agent harnesses write a scratch file to confirm bash works
# ("echo test > .bash-test-tmp"); on 2026-09-07 one such file reached a pull
# request (#4005) as the entire diff, because nothing here matched it. Costs a
# reviewer a round trip and puts junk in the repo root. Named exactly rather
# than globbed -- a pattern like *-tmp would start hiding real files.
.bash-test-tmp
platform/deploy/dist/

# einvoice-preflight: compiled official Schematron (build-schematron.mjs)
ventures/einvoice-preflight/schematron/*.sef.json
ventures/einvoice-preflight/browser/

# shed-designer per-size pages: written at site-build time by make-size-pages.mjs
# (platform/pages/build.mjs, GENERATED_PAGES), never committed.
ventures/shed-designer/how-much-lumber-for-a-*-shed.html
ventures/shed-designer/shed-lumber-list-by-size.html
