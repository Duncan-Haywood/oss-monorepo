.DS_Store
*.log

# Environments — never commit secrets. Each venture scopes its own.
.env
.env.*
!.env.example
.venv/
venv/

# Not `node_modules/`: a trailing slash matches directories only, and a symlink
# named node_modules is not a directory. One was committed that way, pointing at
# an absolute path on one developer's machine. `scripts/ci/tracked_symlinks.py`
# is the control; this pattern is the reason it has less to find.
node_modules
__pycache__/
*.py[cod]
.pytest_cache/
pytest-of-*/
ventures/photo-editing/tmp*/
.mypy_cache/
.ruff_cache/

dist/
build/
.next/
out/
coverage/
*.lcov
security-scan-report.md
security-policy-report.md
gitleaks-report.json
trivy-report.json
sast-report.md

tmp/
tmp*/
**/tmp*/
.coverage
*.tmp
.backups/
.dev-security-report.tmp
.playwright-cli/

# Local one-off test environments.
pytest-of-*/

# Terraform & Hetzner Secrets - Never commit tokens or state
*.tfstate
*.tfstate.*
*.tfvars
!.tfvars.example
.env.hetzner
.terraform/

# Credentials, Keys, & Certificates
*.pem
*.key
*.p12
*.pfx
*.p8
kubeconfig*
id_rsa*
id_ed25519*

# Local deployment notes may contain live credentials.
ventures/quick-pick-survey/quick-pick-secrets.txt

# Local tool caches
.npm/
.terraform.d/
Library/
.claude/

