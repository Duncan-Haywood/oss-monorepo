# App
# Also used as the canonical origin for SEO: sitemap.xml, robots.txt, and
# preview page canonical/Open Graph URLs (src/lib/seo.ts). Set to the real
# production domain before launch — otherwise these point at localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Operator dashboard auth — required before real lead data / outreach at scale
# When unset, /dashboard stays open (demo). When set, proxy + server actions require login.
# OPERATOR_DASHBOARD_PASSWORD=

# Two-layer branding
# Public brand — customer-facing (marketing, outreach, voice agent). Set before launch.
NEXT_PUBLIC_BRAND_NAME=
# Legal entity — Stripe, contracts, compliance (do not change without counsel)
NEXT_PUBLIC_LEGAL_ENTITY=Maris Stella Labs
NEXT_PUBLIC_LEGAL_LOCATION=Colorado, USA
# Optional: DBA / trade name filed with Colorado Secretary of State
# NEXT_PUBLIC_DBA_NAME=

# CAN-SPAM requires a valid physical postal address in outreach emails
NEXT_PUBLIC_COMPANY_ADDRESS=[Registered business address — Colorado, USA]
NEXT_PUBLIC_SUPPORT_EMAIL=support@marisstellalabs.com

# Stripe — merchant account: Maris Stella Labs (legal entity)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — one per bundle tier (see /docs/product-bundles and src/lib/pricing/bundles.ts)
STRIPE_PRICE_ID_STARTER_SETUP=price_...
STRIPE_PRICE_ID_GROWTH_SETUP=price_...
STRIPE_PRICE_ID_GROWTH_MONTHLY=price_...
STRIPE_PRICE_ID_COMPLETE_SETUP=price_...
STRIPE_PRICE_ID_COMPLETE_MONTHLY=price_...
STRIPE_PRICE_ID_COMMERCE_SETUP=price_...
STRIPE_PRICE_ID_COMMERCE_MONTHLY=price_...
# One-shot Price creation: set to 1, POST /api/stripe/bootstrap-prices, paste envSnippet, then unset
# ALLOW_STRIPE_BOOTSTRAP=1

# Preview / production hosting (Vercel)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
NEXT_PUBLIC_PREVIEW_DOMAIN=preview.localsitestudio.com
# Optional root for suggested production hosts ({slug}.localsitestudio.com)
# NEXT_PUBLIC_PRODUCTION_DOMAIN=localsitestudio.com

# Email outreach — From name uses public brand; footer identifies legal entity (CAN-SPAM)
EMAIL_FROM=noreply@marisstellalabs.com
RESEND_API_KEY=re_...

# Voice agent — introduce with public brand name (see /docs/voice-agent-flow)
# VAPI_API_KEY=
# VAPI_ASSISTANT_ID=
# VAPI_WEBHOOK_SECRET=
# VOICE_INBOUND_NUMBER=+1...
# VOICE_OUTBOUND_CALLER_ID=+1...

# Database — Convex (chosen; see /docs/process business decisions)
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_URL=
# CONVEX_AGENT_MODE=anonymous

# Optional: AI site generation / voice LLM / marketing content
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Marketing scheduling (Phase 6 — see /docs/marketing-automation)
# BUFFER_ACCESS_TOKEN=
# GOOGLE_BUSINESS_PROFILE_*=  # OAuth credentials when direct GBP API is enabled
# META_*=                     # Facebook/Instagram OAuth when direct Meta API is enabled
