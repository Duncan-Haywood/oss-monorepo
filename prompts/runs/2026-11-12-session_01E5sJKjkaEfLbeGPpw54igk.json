    "real_defects": [
      {
        "file": "ventures/gitignore-explainer/gitignore.mjs",
        "issue": "parsePaths trimmed leading whitespace before matching the `git status --porcelain` status column, so ` M src/a.js` and ` D old.js` became the paths `M src/a.js` and `D old.js` and anchored rules missed them (the page tells users to paste that output).",
        "patched": true
      },
      {
        "file": "ventures/gitignore-explainer/gitignore.mjs",
        "issue": "git's C-quoted paths (core.quotePath, on by default in status and ls-files --others) were unquoted without decoding and then had backslashes turned into slashes: `\"caf\\303\\251.txt\"` became the made-up folder path `caf/303/251.txt`.",
        "patched": true
      },
      {
        "file": "ventures/gitignore-explainer/gitignore.mjs",
        "issue": "Rename and copy lines `R  x.js -> \"y z.js\"` were read as one path `x.js -> \"y z.js` instead of the new name.",
        "patched": true
      },
      {
        "file": "ventures/gitignore-explainer/gitignore.mjs",
        "issue": "Every line starting with `#` in the path box was dropped as a comment, so `#draft.md` and Emacs `#file#` autosaves printed bare by `git ls-files --others` were never checked.",
        "patched": true
      },
      {
        "file": "ventures/gitignore-explainer/cli/check.mjs",
        "issue": "The CLI read exact names with `git ls-files -z`, then joined them with newlines and sent them through the paste parser: `back\\slash.log` became a folder path, `# hash.log` a comment, `MM x` a status line, and a trailing space was trimmed.",
        "patched": true
      },
      {
        "file": "ventures/gitignore-explainer/gitignore.mjs",
        "issue": "A negation in .git/info/exclude blocked by a root .gitignore folder rule got the negation-blocked finding but no suggested fix (candidate() returned null when bases matched); found while triaging the line-505 mutant.",
        "patched": true
      }
    ]
