      "tokens": "high: summed from the per-request `usage` the API returned, as the transcript recorded it, deduplicated by message id",
      "model": "high: the `model` field on each API response, not the configured model",
      "api_equivalent_usd": "medium: measured tokens x list prices in prompts/pricing.json (as_of stated); an equivalent, not a charge: these runs are billed under a subscription",
      "time": "medium: from transcript timestamps; model time is request-to-response, tool time is call-to-result, time waiting on a person is excluded from active time",
      "human_equivalent": "low: the agent's own estimate of how long a competent person would take, with its basis written down; never measured"
    },
    "not_counted": [
      "requests the harness makes outside the transcript (context compaction summaries, title generation, safety classifiers), if any",
      "transcripts lost when a cloud session moved to a new container: only files present in this container are read, so a resumed session can undercount",
      "server-tool fees (web search is billed per search, not per token); the count is recorded, not priced",
      "CI minutes and the reviewer bots' own model calls"
    ]
  }
}
