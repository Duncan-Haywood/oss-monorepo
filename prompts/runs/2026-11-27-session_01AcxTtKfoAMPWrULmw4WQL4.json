    "real_defects": [
      {
        "file": "ventures/payapps/packages/billing/src/paddle.ts",
        "issue": "verifyPaddleSignature and createBillingProvider accepted a whitespace-only webhook secret (e.g. BILLING_WEBHOOK_SECRET set to a newline by a blank paste). Anyone can compute an HMAC with that key, so forged subscription.activated events would verify and grant paid plans. Reproduced with a forged event under secret '\\n' (accepted). A zero-length secret was already refused by WebCrypto, but as a generic error rather than a signature failure. Same identical code in cmmc, seller-books, einvoice-pro and jobshop-quote copies; all five fixed and tested.",
        "patched": true,
        "patched_in": "https://github.com/Duncan-Haywood/oss-monorepo/pull/19830"
      },
      {
        "file": "ventures/webhook-relay/verify.mjs",
        "issue": "verify() and parseRoutes() only refused a falsy secret, so a route configured with a whitespace (or non-string) secret accepted forged signatures for every HMAC scheme. Now refused at config load and at verify time.",
        "patched": true,
        "patched_in": "https://github.com/Duncan-Haywood/oss-monorepo/pull/19830"
      }
    ]
