[Unit]
Description=Rebuild the portfolio site from main and swap it in (host mode)
Documentation=https://github.com/Duncan-Haywood/monorepo-projects/blob/main/gitops/prod/host/README.md
# Host mode exists precisely because k3s is not available, so there is no
# After= on any cluster unit -- the same call codex-governor.service and
# github-runner.service make.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/portfolio-site/refresh-site.sh

Environment=SITE_REPO_DIR=/opt/portfolio-site/repo
Environment=SITE_STATE_DIR=/var/lib/portfolio-site
Environment=SITE_BASE_URL=https://marisstella.dev/
Environment=SITE_KEEP=3

# Read access to a private origin. `-` so an uncredentialed box still starts
# the unit and refresh-site.sh holds cleanly, rather than systemd failing the
# start and the box looking broken when it is only waiting for a token.
EnvironmentFile=-/etc/portfolio-site/credentials.env

# A wedged clone or a hung build must not sit on the box forever. The build
# itself takes ~25s on this tree; ten minutes is slack for a slow fetch, not a
# budget anything should approach.
TimeoutStartSec=600

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Exactly the two trees a rebuild writes: the deploy checkout it resets, and
# the releases directory it stages into and swaps. Everything else on the box,
# including the nginx configuration this site is served by, is read-only to it.
ReadWritePaths=/opt/portfolio-site /var/lib/portfolio-site

# Unlike the runner and the Codex worker, this one is NOT the low-priority
# tenant by much: it is the thing that keeps the served site current, and it
# runs for well under a minute. Nice=5 keeps it behind nginx answering
# requests without letting a busy box starve the deploy indefinitely.
Nice=5
CPUWeight=50
MemoryMax=2G
