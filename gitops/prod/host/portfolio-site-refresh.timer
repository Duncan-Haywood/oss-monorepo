[Unit]
Description=Rebuild the portfolio site from main periodically (host mode)
Documentation=https://github.com/Duncan-Haywood/monorepo-projects/blob/main/gitops/prod/host/README.md

[Timer]
# Once shortly after boot, so a rebooted box serves current content without
# waiting out a full interval.
OnBootSec=3min
# Then every ten minutes. This is a pull-based deploy standing in for Argo CD's
# own sync loop, and ten minutes is close to Argo's three-minute default
# without rebuilding a 175-tool tree more often than merges arrive. The
# refresh is a no-op when `main` has not moved, so the cost of a tick that
# finds nothing is one `git fetch`.
OnUnitActiveSec=10min
# Spread the tick so a fleet of boxes would not fetch in lockstep.
RandomizedDelaySec=60s
Persistent=true
Unit=portfolio-site-refresh.service

[Install]
WantedBy=timers.target
