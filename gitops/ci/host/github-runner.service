[Unit]
Description=Self-hosted GitHub Actions runner (host mode)
Documentation=https://github.com/Duncan-Haywood/monorepo-projects/blob/main/gitops/ci/host/README.md
# The whole point of host mode is that it does not need k3s, so there is no
# After= on any cluster unit here, mirroring codex-governor.service.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=actions-runner
Group=actions-runner

ExecStart=/bin/bash /opt/actions-runner-host/register-and-run.sh
WorkingDirectory=/opt/actions-runner-host

Environment=GITHUB_REPOSITORY=Duncan-Haywood/monorepo-projects
Environment=RUNNER_HOST_HOME=/opt/actions-runner-host
Environment=RUNNER_HOST_WORK=/var/lib/actions-runner-host/_work
Environment=RUNNER_LABELS=self-hosted,linux,x64,hetzner
Environment=RUNNER_NAME=hetzner-host

# The registration token PAT. Written mode 0600 by the installer and never
# committed. `-` so a box with no credential yet starts the service, and
# register-and-run.sh holds cleanly instead of the unit failing to start.
EnvironmentFile=-/etc/actions-runner-host/credentials.env

# run.sh is long-lived by design (it loops taking one job after another), so
# unlike codex-governor's oneshot tick this is Type=simple with Restart=always.
# RestartSec backs off enough that a box with no credential yet, or a run.sh
# that exits because GitHub removed the runner, does not spin a tight loop.
Restart=always
RestartSec=300
# A registration or download that hangs (a dead mirror, a wedged API call)
# should not tie up the box forever; TimeoutStartSec only bounds the initial
# start, so this also gives run.sh itself a maximum single-job wall clock via
# the workflow's own job timeout, not this unit.
TimeoutStartSec=1800

# The equivalent of gitops/ci/runner.yaml's pod securityContext.
# Not ProtectHome: the runner's own $HOME under here holds its npm/tool
# caches (RUNNER_TOOL_CACHE) and `config.sh`/`run.sh` need to write next to
# themselves (the extracted tarball, .runner, .credentials).
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# Everything a job might legitimately write: its own extracted binaries and
# config, and the _work tree jobs check out into and tool-install into. A
# workflow step running `npm ci` or `actions/setup-node` needs both writable,
# which is inherent to running arbitrary job code, not something to narrow
# further -- gitops/ci/runner.yaml's own comment makes the same call for the
# in-cluster path.
ReadWritePaths=/opt/actions-runner-host /var/lib/actions-runner-host

# The low-priority tenant on this box, matching runner.yaml's
# priorityClassName: ci-low and codex-governor.service's own Nice/CPUWeight.
# If the box is also serving the portfolio, the site wins.
Nice=10
IOSchedulingClass=idle
CPUWeight=20
MemoryMax=3G

[Install]
WantedBy=multi-user.target
