[Unit]
Description=Tick the Codex governor every five minutes (host mode)
Documentation=https://github.com/Duncan-Haywood/monorepo-projects/blob/main/gitops/agents/host/README.md

[Timer]
# The same cadence as `agents/governor/cronjob.yaml`. The governor is cheap
# when it decides to hold — it reads two files and exits — and the interval is
# what bounds how long a freed budget slot sits unused.
OnBootSec=2min
OnUnitActiveSec=5min

# A tick is a poll, not a deadline: if the box was off, the queue is still
# there and running a burst of catch-up ticks would only spend budget faster.
Persistent=false

# Five minutes is short enough that a fleet of boxes ticking in lockstep is
# worth avoiding, and the run is long, so the jitter is cheap insurance rather
# than a real contention fix.
RandomizedDelaySec=30s

AccuracySec=30s

[Install]
WantedBy=timers.target
