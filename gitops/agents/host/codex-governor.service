[Unit]
Description=Codex governor tick (host mode)
Documentation=https://github.com/Duncan-Haywood/monorepo-projects/blob/main/gitops/agents/host/README.md
# The whole point of host mode is that it does not need k3s, so there is no
# After= on any cluster unit here. It does need the network: worker.sh clones
# the repository and talks to the Codex API.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# One tick. It holds an flock for its whole duration and runs the worker
# synchronously, so systemd's own refusal to start a second instance of a
# oneshot service is the primary concurrency guard and the lock is the backstop
# for an operator running --once by hand at the same moment.
ExecStart=/usr/bin/python3 /opt/codex-agents/host/host_governor.py --once

# Where the checkout of this repository's agents tree lives on the box. The
# installer places governor.py, host_governor.py, worker.sh, mandate.md,
# policy.json and queue/ under here.
WorkingDirectory=/opt/codex-agents

# The Codex and GitHub credentials. Written mode 0600 by the installer and
# never committed. `-` so a box that has not been given credentials yet starts
# the timer and holds on the auth cooldown, rather than failing to start at
# all with a message only `systemctl status` shows.
EnvironmentFile=-/etc/codex-agents/credentials.env

Environment=CODEX_HOST_STATE=/var/lib/codex-governor/state.json
Environment=CODEX_HOST_LOCK=/var/lib/codex-governor/tick.lock
Environment=CODEX_HOST_QUEUE=/opt/codex-agents/queue
Environment=CODEX_HOST_POLICY=/opt/codex-agents/governor/policy.json
Environment=CODEX_HOST_WORKER=/opt/codex-agents/workers/worker.sh
Environment=CODEX_HOST_MANDATE=/opt/codex-agents/workers/mandate.md
Environment=CODEX_STATE_DIR=/var/lib/codex
Environment=CODEX_TOOLS_DIR=/var/lib/codex-tools

# worker.sh redirects the Codex CLI's own state (CODEX_HOME=$CODEX_STATE_DIR/
# home, above) and npm's install target (npm_config_prefix) away from $HOME --
# but not everything it shells out to. `npm install -g` still falls back to
# its default *cache* at ~/.npm, and `gh` falls back to ~/.config/gh, because
# neither is told otherwise. This process's real $HOME is /root (root, no
# User=), and ProtectHome=true below makes /root inaccessible and empty, not
# merely read-only -- so left unset, the first tick that actually reaches
# `install_codex` (a held tick, with no credentials yet, never does) fails
# outright on a write no one sees coming. Pointing $HOME at the same
# already-writable, already-declared directory CODEX_STATE_DIR names above
# fixes it without carving out /root and weakening ProtectHome for everything
# else that lives there.
Environment=HOME=/var/lib/codex

# A tick that has not finished in an hour is wedged. host_governor.py enforces
# the same ceiling on the worker subprocess itself (CODEX_HOST_JOB_TIMEOUT) and
# records the result as a failure; this is the outer backstop for the case where
# the driver itself is what hung, and it is deliberately a little longer so the
# inner deadline is the one that normally fires and gets accounted for.
TimeoutStartSec=4200

# The Job this replaces sets a securityContext; these are the systemd
# equivalents of the same narrowing. Not runAsNonRoot: worker.sh installs the
# Codex CLI and gh under $HOME and clones into a temp dir, so it needs a
# writable home -- the k8s side documents the same exception by leaving its
# whole root filesystem writable. Here $HOME is redirected instead (see
# above), so ProtectHome=true below can stay on rather than needing the same
# blanket exception.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
# The three paths above that must stay writable, and nothing else.
ReadWritePaths=/var/lib/codex-governor /var/lib/codex /var/lib/codex-tools

# Codex is the low-priority tenant on this box by design — the same intent as
# the Job's `priorityClassName: agents-low` and its CPU/memory requests. If the
# box is also serving the portfolio, the site wins.
Nice=10
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=3G
MemoryMax=4G

[Install]
WantedBy=multi-user.target
