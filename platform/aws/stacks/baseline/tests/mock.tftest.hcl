run "baseline_shape" {
  command = plan

  assert {
    condition     = aws_cloudtrail.org.is_organization_trail && aws_cloudtrail.org.enable_log_file_validation
    error_message = "organisation trail with log file validation"
  }

  assert {
    condition     = aws_s3_bucket_object_lock_configuration.logs.rule[0].default_retention[0].days == 365
    error_message = "log bucket is object-locked for a year"
  }

  assert {
    condition     = aws_guardduty_organization_configuration.this.auto_enable_organization_members == "ALL"
    error_message = "GuardDuty on in every account"
  }

  assert {
    condition     = length(aws_securityhub_configuration_policy.baseline.configuration_policy[0].enabled_standard_arns) == 2
    error_message = "FSBP and CIS enabled"
  }
}
