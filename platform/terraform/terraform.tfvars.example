# Copy this file to terraform.tfvars and fill in your secrets
hcloud_token      = "YOUR_HETZNER_CLOUD_API_TOKEN"
gitea_admin_password  = "GENERATE_A_UNIQUE_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
pairwise_db_password  = "GENERATE_A_DIFFERENT_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
admin_basic_auth_users = "admin:$2y$REPLACE_WITH_AN_HTPASSWD_HASH"
grafana_admin_password = "GENERATE_ANOTHER_UNIQUE_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
server_ip         = "89.167.29.39"
letsencrypt_email = "admin@yourdomain.com"

services = {
  "web-portal" = {
    domain   = "portal.yourdomain.com"
    image    = "nginxdemos/hello"
    tag      = "plain-text"
    replicas = 2
    port     = 80
  }
}
