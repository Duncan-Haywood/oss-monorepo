# Copy this file to terraform.tfvars and fill in your secrets
hcloud_token      = "YOUR_HETZNER_CLOUD_API_TOKEN"
gitea_admin_password  = "GENERATE_A_UNIQUE_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
pairwise_db_password  = "GENERATE_A_DIFFERENT_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
admin_basic_auth_users = "admin:$2y$REPLACE_WITH_AN_HTPASSWD_HASH"
grafana_admin_password = "GENERATE_ANOTHER_UNIQUE_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
code_server_password = "GENERATE_A_CODE_SERVER_PASSWORD_OF_AT_LEAST_20_CHARACTERS"
# The codercom/code-server release to run. There is no default: terraform
# refuses to plan without it, and its validation refuses anything that is not a
# digest or a version, because both code-server releases answer on public
# Traefik ingresses.
code_server_image_tag = "REPLACE_WITH_A_CODE_SERVER_VERSION_OR_sha256_DIGEST"
server_ip         = "89.167.29.39"
letsencrypt_email = "admin@yourdomain.com"

# `tag` is required and must name one specific build — a version or a
# `sha256:` digest. It used to default to "latest", which meant a service that
# omitted it floated silently onto whatever was pushed last. Every entry here
# becomes a public TLS ingress via `services.tf`, so the tag is the only record
# of what is actually answering on that hostname.
services = {
  "web-portal" = {
    domain   = "portal.yourdomain.com"
    image    = "nginxdemos/hello"
    tag      = "REPLACE_WITH_AN_IMMUTABLE_TAG_OR_sha256_DIGEST"
    replicas = 2
    port     = 80
  }
}
