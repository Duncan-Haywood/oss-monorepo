{
  "name": "retail-pilot-intel",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "ci": "tsx scripts/ci.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "docs:sync": "tsx scripts/sync-html-docs.ts",
    "docs:dev": "pnpm run docs:sync && pnpm --filter @retail-pilot/docs dev",
    "docs:build": "pnpm run docs:sync && pnpm --filter @retail-pilot/docs build",
    "portal:dev": "pnpm --filter @retail-pilot/portal dev",
    "portal:build": "pnpm --filter @retail-pilot/portal build"
  },
  "devDependencies": {
    "marked": "^15.0.12",
    "@eslint/js": "^9.28.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0"
  },
  "engines": {
    "node": ">=22"
  }
}
