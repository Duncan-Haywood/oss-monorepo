# Required in production — shared secret for docs login and session cookies
DOCS_SITE_TOKEN=replace-with-long-random-secret

# Optional — shown in site metadata and deployment docs (e.g. docs.shootflow.internal)
DOCS_SITE_DOMAIN=docs.shootflow.internal

# Optional — restrict login to these emails when using Vercel Deployment Protection + this app
# DOCS_ALLOWED_EMAILS=you@example.com,teammate@example.com
